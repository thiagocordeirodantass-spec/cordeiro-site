{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix frontend-modern install && npm --prefix backend install",
  "buildCommand": "npm --prefix frontend-modern run build",
  "outputDirectory": "frontend-modern/dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
